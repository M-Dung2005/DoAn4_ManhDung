{
  "name": "smartshop-be",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:admin": "npm run build && node scripts/verify-admin.mjs",
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "npm run build && node scripts/migrate.mjs",
    "migrate:auth": "npm run build && node scripts/migrate-auth.mjs",
    "migrate:permissions": "npm run build && node scripts/migrate-permissions.mjs",
    "migrate:collations": "npm run build && node scripts/migrate-collations.mjs",
    "start": "node dist/app.js",
    "seed": "node scripts/setup-smartshop.mjs --apply --seed-only",
    "seed:accounts": "node scripts/seed-smartshop-accounts.mjs",
    "expand:catalog": "node scripts/expand-smartshop-catalog.mjs",
    "backfill:inventory": "node scripts/backfill-smartshop-inventory.mjs",
    "setup:smartshop": "node scripts/setup-smartshop.mjs",
    "init:smartshop": "node scripts/setup-smartshop.mjs --apply --from-schema",
    "assets:smartshop": "node scripts/download-smartshop-images.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
